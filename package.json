{
  "name": "p0-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "ops-tools/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "ratchet": "bun ops-tools/ratchet/cli.ts check",
    "ratchet:update": "bun ops-tools/ratchet/cli.ts update",
    "db:push": "bun run --filter @p0/db db:push",
    "auth:generate": "bun run --filter @p0/accounts auth:generate",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "eslint": "^9.15.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "knip": "^5.41.0",
    "lefthook": "^1.10.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  },
  "packageManager": "bun@1.3.14"
}
