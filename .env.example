# ── db ────────────────────────────────────────────────
DATABASE_URL=postgres://p0:p0@localhost:5432/p0

# ── app ───────────────────────────────────────────────
# prod면 시크릿/https/이메일인증을 boot 타임에 강제 검증
APP_ENV=dev

# ── auth (better-auth) ────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
# prod에서는 https 필수 (Secure 쿠키). env가 boot 시 검증.
BETTER_AUTH_URL=http://localhost:4000
PORT=4000
# 브라우저 FE origin 화이트리스트(콤마 구분) — CORS + CSRF(trustedOrigins). 크로스오리진 FE면 필수
TRUSTED_ORIGINS=

# ── oauth providers (없으면 비활성) ────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── billing (stripe) ──────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# plan × cycle Price ID — 미설정 plan은 checkout 불가
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_ANNUAL=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_ANNUAL=

# ── email ─────────────────────────────────────────────
# 키 없으면 콘솔 출력 폴백 (dev)
RESEND_API_KEY=
EMAIL_FROM=p0 <onboarding@resend.dev>
# prod에서 true — 가입 시 이메일 인증 강제
REQUIRE_EMAIL_VERIFICATION=false
